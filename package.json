{
  "name": "adpilot",
  "version": "0.1.0",
  "private": true,
  "description": "AdPilot WordPress console and editor assets",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test frontend/api.test.mjs",
    "lint:php": "php scripts/plugin.php lint",
    "test:php": "php tests/php/run.php",
    "package": "npm run build && php scripts/plugin.php package"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  }
}
